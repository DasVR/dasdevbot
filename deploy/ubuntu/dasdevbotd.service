[Unit]
Description=dasdevbot daemon
After=network-online.target

[Service]
Type=simple
User=dasdevbot
Group=dasdevbot
Environment=HOME=/var/lib/dasdevbot
ExecStart=/usr/local/bin/dasdevbotd serve --provider claude-cli --claude-home /var/lib/dasdevbot --data /var/lib/dasdevbot/dasdevbot.sqlite
NoNewPrivileges=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
