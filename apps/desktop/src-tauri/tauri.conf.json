{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dasdevbot",
  "version": "0.1.0",
  "identifier": "net.dasdev.dasdevbot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 http://localhost:8787; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "dasdevbot",
        "width": 1120,
        "height": 760
      },
      {
        "label": "card",
        "title": "dasdevbot card",
        "width": 480,
        "height": 640,
        "visible": false
      },
      {
        "label": "settings",
        "title": "dasdevbot settings",
        "width": 720,
        "height": 560,
        "visible": false
      },
      {
        "label": "voice",
        "title": "dasdevbot voice",
        "width": 420,
        "height": 240,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
