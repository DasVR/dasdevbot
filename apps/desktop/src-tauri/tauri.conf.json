{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dasdevbot",
  "version": "0.1.0",
  "identifier": "net.dasdev.dasdevbot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 http://localhost:8787; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "dasdevbot",
        "width": 1360,
        "height": 828,
        "minWidth": 400,
        "minHeight": 52,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "card",
        "title": "dasdevbot card",
        "width": 560,
        "height": 760,
        "visible": false,
        "resizable": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "dasdevbot settings",
        "width": 720,
        "height": 560,
        "visible": false
      },
      {
        "label": "voice",
        "title": "dasdevbot voice",
        "width": 420,
        "height": 240,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "DasVR",
    "shortDescription": "dasdevbot desktop demo (unsigned)",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "signCommand": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "customLanguageFiles": {
          "English": "nsis/English.nsh"
        },
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
